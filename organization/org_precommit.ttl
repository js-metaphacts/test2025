  dct:created "2024-03-21T11:51:46.886Z"^^xsd:dateTime;
  dct:creator "admin";
  dct:modified "2024-03-21T11:51:46.886Z"^^xsd:dateTime;
  rdfs:isDefinedBy <https://ontologies.metaphacts.com/organization-ontology/0.2>;
  rdfs:label "Company"@en;
  rdfs:subClassOf <https://ontologies.metaphacts.com/organization-ontology/Organization> .

<https://ontologies.metaphacts.com/organization-ontology/Organization> a owl:Class;
  <http://open-services.net/ns/core#modifiedBy> "academyuser";
  dct:contributor "aaronEberhart", "academyuser", "admin";
  dct:created "2024-03-08T11:34:39.476Z"^^xsd:dateTime;
  dct:creator "aaronEberhart";
  dct:modified "2025-02-27T10:45:11.244Z"^^xsd:dateTime;
  rdfs:isDefinedBy <https://ontologies.metaphacts.com/organization-ontology/0.2>;
  rdfs:label "Organization"@en;
  rdfs:subClassOf [ a owl:Restriction;
      owl:allValuesFrom <https://ontologies.metaphacts.com/organization-ontology/Project>;
      owl:onProperty <https://ontologies.metaphacts.com/organization-ontology/isInvolvedIn>
    ], [ a owl:Restriction;
      owl:onDataRange xsd:date;
      owl:onProperty <https://ontologies.metaphacts.com/organization-ontology/dateFounded>
    ], [ a owl:Restriction;
      owl:onDataRange xsd:string;
      owl:onProperty rdfs:label
    ], [ a owl:Restriction;
      owl:allValuesFrom <https://ontologies.metaphacts.com/organization-ontology/Person>;
      owl:onProperty <https://ontologies.metaphacts.com/organization-ontology/hasMember>
    ], [ a owl:Restriction;
      owl:allValuesFrom <https://ontologies.metaphacts.com/organization-ontology/Position>;
      owl:onProperty <https://ontologies.metaphacts.com/organization-ontology/hasPosition>
    ] .

<https://ontologies.metaphacts.com/organization-ontology/Person> a owl:Class;
  <http://open-services.net/ns/core#modifiedBy> "academyuser";
  dct:contributor "aaronEberhart", "academyuser", "admin";
  dct:created "2024-03-08T11:34:51.902Z"^^xsd:dateTime;
  dct:creator "aaronEberhart";
  dct:modified "2025-02-28T19:11:25.976Z"^^xsd:dateTime;
  rdfs:isDefinedBy <https://ontologies.metaphacts.com/organization-ontology/0.2>;
  rdfs:label "Person"@en;
  rdfs:subClassOf [ a owl:Restriction;
      owl:onDataRange xsd:string;
      owl:onProperty <https://schema.org/thumbnail>
    ], [ a owl:Restriction;
      owl:onDataRange xsd:string;
      owl:onProperty rdfs:label
    ], [ a owl:Restriction;
      owl:allValuesFrom _:4f56aa4b31ff3ec2c1282e6a76270a54;
      owl:onProperty <https://ontologies.metaphacts.com/organization-ontology/hasRole>
    ], [ a owl:Restriction;
      owl:allValuesFrom <https://ontologies.metaphacts.com/organization-ontology/Person>;
      owl:onProperty <https://ontologies.metaphacts.com/organization-ontology/knows>
    ], [ a owl:Restriction;
      owl:cardinality 1;
      owl:onDataRange xsd:date;
      owl:onProperty <https://ontologies.metaphacts.com/organization-ontology/hasBirthday>
    ], [ a owl:Restriction;
      owl:allValuesFrom <https://ontologies.metaphacts.com/organization-ontology/Project>;
      owl:onProperty <https://ontologies.metaphacts.com/organization-ontology/isInvolvedIn>
    ] .

<https://ontologies.metaphacts.com/organization-ontology/Position> a owl:Class;
  <http://open-services.net/ns/core#modifiedBy> "aaronEberhart";
  dct:contributor "aaronEberhart";
  dct:created "2024-03-08T12:14:53.237Z"^^xsd:dateTime;
  dct:creator "aaronEberhart";
  dct:modified "2024-03-08T12:29:59.398Z"^^xsd:dateTime;
  rdfs:comment "The Position class represents the roles of people in the organization which may not be in permanent 1-to-1 alignment. For instance if a Role is performed by multiple People, or if a person has multiple roles over time or at once, this can be captured by Position"@en;
  rdfs:isDefinedBy <https://ontologies.metaphacts.com/organization-ontology/0.2>;
  rdfs:label "Position"@en;
  rdfs:subClassOf [ a owl:Restriction;
      owl:allValuesFrom <https://ontologies.metaphacts.com/organization-ontology/Person>;
      owl:minCardinality 1;
      owl:onProperty <https://ontologies.metaphacts.com/organization-ontology/filledBy>
    ], [ a owl:Restriction;
      owl:allValuesFrom _:4f56aa4b31ff3ec2c1282e6a76270a54;
      owl:minCardinality 1;
      owl:onProperty <https://ontologies.metaphacts.com/organization-ontology/hasRole>
    ], [ a owl:Restriction;
      owl:onDataRange xsd:dateTime;
      owl:onProperty dct:date
    ] .

_:4f56aa4b31ff3ec2c1282e6a76270a54 a owl:Class;
  owl:unionOf (skos:Concept <https://ontologies.metaphacts.com/organization-ontology/Role>) .

<https://ontologies.metaphacts.com/organization-ontology/Project> a owl:Class;
